{
  "name": "smartrecomenda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/start-dev.mjs",
    "dev:frontend": "vite --host 0.0.0.0 --port 3000",
    "dev:backend": "node scripts/run-python.mjs -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000",
    "start": "node scripts/start-prod.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {}
}
